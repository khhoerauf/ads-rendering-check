{
	"devDependencies": {
		"cypress": "^15.14.1",
		"cypress-image-diff-html-report": "^2.2.0",
		"cypress-image-diff-js": "^2.8.0",
		"playwright-webkit": "^1.50.0",
		"prettier": "^3.3.3"
	},
	"scripts": {
		"cy:open": "cypress open",
		"cy:run:chrome": "cypress run --browser chrome --spec cypress/e2e/functional-*test.js",
		"cy:run:firefox": "cypress run --browser firefox --spec cypress/e2e/functional-*test.js",
		"cy:run:webkit": "cypress run --browser webkit --spec cypress/e2e/functional-*test.js",
		"cy:run:all": "npm run cy:run:chrome && npm run cy:run:firefox && npm run cy:run:webkit",
		"cy:run:visual": "cypress run --browser chrome --spec cypress/e2e/visual-*test.js",
		"format": "prettier --write ."
	}
}
